<!--
  IFN flavour EDProducer plugins. These talk to the vendored fastjet 3.4.1 + IFN
  code ONLY through the fastjet-free ifnflavour:: wrapper in PhysicsTools/IFNFlavour,
  so we must NOT <use name="fastjet"/> here (that would re-expose the cvmfs 3.3.0
  headers/symbols). The wrapper library carries the (hidden) fastjet 3.4.1 internally.
-->
<use name="PhysicsTools/IFNFlavour"/>
<use name="FWCore/Framework"/>
<use name="FWCore/PluginManager"/>
<use name="FWCore/ParameterSet"/>
<use name="FWCore/ServiceRegistry"/>
<use name="FWCore/Utilities"/>
<use name="DataFormats/JetReco"/>
<use name="DataFormats/Candidate"/>
<use name="DataFormats/HepMCCandidate"/>
<use name="DataFormats/Math"/>
<use name="PhysicsTools/JetMCUtils"/>
<use name="DataFormats/NanoAOD"/>
<use name="SimDataFormats/JetMatching"/>
<use name="CommonTools/Utils"/>
<use name="CommonTools/UtilAlgos"/>
<use name="root"/>
<use name="fastjet"/>
<use name="fastjet/contrib"/>

<library file="*.cc" name="PhysicsToolsIFNFlavourPlugins">
  <flags EDM_PLUGIN="1"/>
  <flags CXXFLAGS="-I$(LOCALTOP)/src/PhysicsTools/IFNFlavour/fastjet341/include -DDROP_CGAL -fvisibility=hidden -fvisibility-inlines-hidden -w"/>
</library>
